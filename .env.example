# Application
APP_NAME=Research Alignment Agent
APP_VERSION=1.0.0
DEBUG=false
PORT=8000

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Database
DATABASE_URL=sqlite:///./research_agent.db

# ChromaDB (defaults to ~/.local_chroma_data_v12 if not set)
CHROMA_DB_PATH=
CHROMA_COLLECTION=research_papers_v12

# CORS (comma-separated origins; default http://localhost:5173)
CORS_ORIGINS=["http://localhost:5173"]

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
